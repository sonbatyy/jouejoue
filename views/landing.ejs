<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Home' }) %>
</head>
<body>
  <%- include('layout-partials/page-bg', { hideEmojiField: true }) %>

  <div class="container">
    <%- include('layout-partials/nav') %>

    <section class="section hero hero--minimal">
      <div class="hero__stickers" aria-hidden="true">
        <span class="hero__sticker hero__sticker--1">🎂</span>
        <span class="hero__sticker hero__sticker--2">🦆</span>
        <span class="hero__sticker hero__sticker--3">🐦</span>
        <span class="hero__sticker hero__sticker--4">🍓</span>
      </div>
      <p class="eyebrow">A tiny gesture, sent as a game</p>
      <h1>Turn your question into a game only <span class="wash-text">they</span> can answer.</h1>
      <p class="hero__subhead">
        Pick a minigame, write what you want to ask, send the link. They play, then answer — straight to your inbox.
      </p>
      <div class="hero__actions hero__actions--big">
        <a href="/demo" class="btn btn-primary btn-lg">Try a free demo</a>
        <a href="/games" class="btn btn-secondary btn-lg">Browse games</a>
      </div>
    </section>

    <%- include('layout-partials/footer') %>
  </div>

  <script src="/js/reveal.js"></script>
  <script src="/js/games/shared.js"></script>
  <script src="/js/emoji-field.js"></script>
</body>
</html>
