<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Checkout · ' + company.name }) %>
</head>
<body>
  <%- include('layout-partials/page-bg', { hideEmojiField: true }) %>

  <div class="container">
    <%- include('layout-partials/nav') %>

    <section class="section-tight" style="max-width: 420px; margin: 0 auto;">
      <p class="eyebrow">Checkout (mock, nothing is charged)</p>
      <h1 style="font-size: 26px;">Confirm your batch</h1>

      <div class="form-card" style="margin-top: 18px;">
        <div class="order-summary">
          <div class="order-summary__row"><span><%= templateName %> · <%= config.mode %></span><strong><%= config.quantity %> codes</strong></div>
          <div class="order-summary__row" style="margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--color-border);"><span>Per code</span><strong><%= perCode %></strong></div>
          <div class="order-summary__row" style="margin-top: 6px; font-size: 17px;"><span>Total</span><strong><%= total %></strong></div>
        </div>

        <form method="POST" action="/company/<%= company.manage_token %>/batches" autocomplete="off">
          <input type="hidden" name="templateId" value="<%= config.templateId %>" />
          <input type="hidden" name="level" value="<%= config.level %>" />
          <input type="hidden" name="mode" value="<%= config.mode %>" />
          <input type="hidden" name="defaultQuestion" value="<%= config.defaultQuestion %>" />
          <input type="hidden" name="answersTo" value="<%= config.answersTo %>" />
          <input type="hidden" name="rewardWin" value="<%= config.rewardWin %>" />
          <input type="hidden" name="rewardLose" value="<%= config.rewardLose %>" />
          <input type="hidden" name="quantity" value="<%= config.quantity %>" />
          <input type="hidden" name="logoUrl" value="<%= config.logoUrl %>" />
          <input type="hidden" name="accentColor" value="<%= config.accentColor %>" />

          <label for="cardName">Name on card</label>
          <input type="text" id="cardName" name="cardName" placeholder="Jane Doe" />
          <label for="cardNumber">Card number</label>
          <input type="text" id="cardNumber" name="cardNumber" placeholder="4242 4242 4242 4242" inputmode="numeric" maxlength="19" />
          <div class="form-row">
            <div>
              <label for="cardExpiry">Expiry</label>
              <input type="text" id="cardExpiry" name="cardExpiry" placeholder="MM / YY" inputmode="numeric" maxlength="5" />
            </div>
            <div>
              <label for="cardCvc">CVC</label>
              <input type="text" id="cardCvc" name="cardCvc" placeholder="123" inputmode="numeric" maxlength="4" />
            </div>
          </div>

          <button type="submit" class="btn btn-primary wash">Pay <%= total %></button>
          <p class="form-fineprint">This is a prototype. No card processor is connected, nothing you type here is saved, and no money moves.</p>
        </form>
      </div>
    </section>

    <%- include('layout-partials/footer') %>
  </div>
  <script src="/js/games/shared.js"></script>
  <script src="/js/card-input.js"></script>
</body>
</html>
