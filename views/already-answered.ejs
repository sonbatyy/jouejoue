<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Already answered' }) %>
</head>
<body>
  <div class="status-page">
    <div class="status-page__card">
      <p class="eyebrow">Already played</p>
      <h1 style="font-size: 26px;">This one's done</h1>
      <p>Someone already caught the <%= template.name %> and answered:</p>
      <p style="font-size: 18px; font-weight: 700; color: var(--color-ink);">&ldquo;<%= instance.question %>&rdquo;</p>
      <a href="/" class="btn btn-secondary" style="margin-top: 16px;">Back to home</a>
    </div>
  </div>
</body>
</html>
