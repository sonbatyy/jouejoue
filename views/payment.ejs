<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Payment · ' + template.name }) %>
</head>
<body>
  <div class="page-bg">
    <div class="page-bg__blob page-bg__blob--1"></div>
    <div class="page-bg__blob page-bg__blob--2"></div>
  </div>

  <div class="container">
    <%- include('layout-partials/nav') %>

    <section class="section-tight">
      <div style="text-align: center; max-width: 560px; margin: 0 auto;">
        <p class="eyebrow">Checkout (mock, nothing is charged)</p>
        <h1 style="font-size: 30px;">Pay for <%= template.name %></h1>
      </div>

      <div class="form-card" style="margin-top: 24px; max-width: 420px;">
        <div class="order-summary">
          <div class="order-summary__row">
            <span><%= template.name %></span>
            <strong id="orderPrice"><%= template.priceDisplay %></strong>
          </div>
          <div class="order-summary__row order-summary__row--currency">
            <label for="currencySelect">Currency</label>
            <select id="currencySelect">
              <% currencies.forEach(function(code) { %>
                <option value="<%= code %>" <%= code === currency ? 'selected' : '' %>><%= code %></option>
              <% }); %>
            </select>
          </div>
          <p class="form-fineprint" style="margin: 6px 0 0;">Priced in <%= currency %> based on your location — pick another currency just to see the equivalent.</p>
        </div>

        <form method="POST" action="/payment/<%= template.id %>" autocomplete="off">
          <label for="cardName">Name on card</label>
          <input type="text" id="cardName" name="cardName" placeholder="Jane Doe" />

          <label for="cardNumber">Card number</label>
          <input type="text" id="cardNumber" name="cardNumber" placeholder="4242 4242 4242 4242" inputmode="numeric" maxlength="19" />

          <div class="form-row">
            <div>
              <label for="cardExpiry">Expiry</label>
              <input type="text" id="cardExpiry" name="cardExpiry" placeholder="MM / YY" inputmode="numeric" maxlength="5" />
            </div>
            <div>
              <label for="cardCvc">CVC</label>
              <input type="text" id="cardCvc" name="cardCvc" placeholder="123" inputmode="numeric" maxlength="4" />
            </div>
          </div>

          <button type="submit" class="btn btn-primary wash" id="payButton">Pay <%= template.priceDisplay %></button>
          <p class="form-fineprint">This is a prototype. No card processor is connected, nothing you type here is saved, and no money moves. You're always actually charged in <%= currency %> — other currencies shown are just equivalents.</p>
        </form>
      </div>
    </section>

    <%- include('layout-partials/footer') %>
  </div>

  <script>
    window.__PRICES__ = <%- JSON.stringify(allPrices) %>;
  </script>
  <script src="/js/currency-select.js"></script>
  <script src="/js/card-input.js"></script>
</body>
</html>
