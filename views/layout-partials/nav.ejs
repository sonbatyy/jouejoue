<nav class="site-nav">
  <a href="/" class="site-nav__logo">
    <span class="logo-mark" aria-hidden="true">
      <span class="logo-mark__j logo-mark__j--a">J</span>
      <span class="logo-mark__j logo-mark__j--b">J</span>
    </span>
    <span class="wordmark">JoueJoue</span>
  </a>
  <button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls="site-nav-links" aria-label="Open menu">
    <span class="site-nav__toggle-bar"></span>
    <span class="site-nav__toggle-bar"></span>
    <span class="site-nav__toggle-bar"></span>
  </button>
  <ul class="site-nav__links" id="site-nav-links">
    <li><a href="/#how-it-works" class="nav-underline">How it works</a></li>
    <li><a href="/#pricing" class="nav-underline">Pricing</a></li>
    <li><a href="/#catalog" class="nav-underline">Games</a></li>
