<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Your link is ready' }) %>
</head>
<body>
  <div class="page-bg">
    <div class="page-bg__blob page-bg__blob--1"></div>
    <div class="page-bg__blob page-bg__blob--2"></div>
  </div>

  <div class="container">
    <%- include('layout-partials/nav') %>

    <section class="section-tight" style="text-align: center; max-width: 560px; margin: 0 auto;">
      <p class="eyebrow">Ready to send</p>
      <h1 style="font-size: 30px;">Your <%= template.name %> link is live</h1>
      <p>Send this to whoever you're asking. It stays live for a month, and you'll get an email the moment they answer.</p>

      <div class="share-box">
        <input type="text" id="share-url" value="<%= shareUrl %>" readonly />
        <button class="btn btn-primary" id="copy-btn" type="button">Copy link</button>
      </div>

      <p style="margin-top: 28px;"><a href="/" class="nav-underline">← Back to home</a></p>
    </section>

    <%- include('layout-partials/footer') %>
  </div>

  <script>
    document.getElementById('copy-btn').addEventListener('click', async () => {
      const input = document.getElementById('share-url');
      input.select();
      try {
        await navigator.clipboard.writeText(input.value);
        const btn = document.getElementById('copy-btn');
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch (err) {
        // clipboard API unavailable, the input is already selected for manual copy
      }
    });
  </script>
</body>
</html>
