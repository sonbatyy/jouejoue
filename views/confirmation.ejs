<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Your link is ready' }) %>
</head>
<body>
  <%- include('layout-partials/page-bg') %>

  <div class="container">
    <%- include('layout-partials/nav') %>

    <section class="section-tight" style="text-align: center; max-width: 560px; margin: 0 auto;">
      <% if (instance.delivery_method === 'email') { %>
        <p class="eyebrow">Sent!</p>
        <h1 style="font-size: 30px;">We emailed it to <%= instance.recipient_name %></h1>
        <p>It went straight to <%= instance.recipient_email %> with your name and note attached. It stays live for a month, and you'll get an email the moment they answer.</p>
      <% } else { %>
        <p class="eyebrow">Ready to send</p>
        <h1 style="font-size: 30px;">Your <%= template.name %> link is live</h1>
        <p>Send this to whoever you're asking. It stays live for a month, and you'll get an email the moment they answer.</p>
      <% } %>

      <div class="share-box">
        <input type="text" id="share-url" value="<%= shareUrl %>" readonly />
        <button class="btn btn-primary" id="copy-btn" type="button">Copy link</button>
      </div>

      <div class="confirm-qr">
        <img src="<%= qrDataUrl %>" alt="QR code for the game link" class="confirm-qr__img" />
        <p class="confirm-qr__caption">Or let them scan this. Print it, screenshot it, put it on a card.</p>
        <div class="confirm-qr__actions">
          <button class="btn btn-secondary" id="share-btn" type="button" hidden>Share…</button>
          <a class="btn btn-secondary" id="qr-download" href="<%= qrDataUrl %>" download="joue-joue-qr.png">Save QR image</a>
        </div>
      </div>

      <p style="margin-top: 28px;"><a href="/" class="nav-underline">← Back to home</a></p>
    </section>

    <%- include('layout-partials/footer') %>
  </div>

  <script>
    var shareUrl = <%- JSON.stringify(shareUrl) %>;
    document.getElementById('copy-btn').addEventListener('click', async () => {
      const input = document.getElementById('share-url');
      input.select();
      try {
        await navigator.clipboard.writeText(input.value);
        const btn = document.getElementById('copy-btn');
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch (err) {
        // clipboard API unavailable, the input is already selected for manual copy
      }
    });

    // Native share sheet where the browser supports it (phones, mostly) —
    // lets them fire the link straight into whatever messaging app.
    var shareBtn = document.getElementById('share-btn');
    if (navigator.share) {
      shareBtn.hidden = false;
      shareBtn.addEventListener('click', function () {
        navigator.share({ title: 'A game for you', url: shareUrl }).catch(function () {});
      });
    }
  </script>
  <script src="/js/games/shared.js"></script>
  <script src="/js/emoji-field.js"></script>
</body>
</html>
