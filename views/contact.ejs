<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Contact us' }) %>
</head>
<body>
  <div class="page-bg">
    <div class="page-bg__blob page-bg__blob--1"></div>
    <div class="page-bg__blob page-bg__blob--2"></div>
  </div>

  <div class="container">
    <%- include('layout-partials/nav') %>

    <section class="section-tight">
      <div style="text-align: center; max-width: 560px; margin: 0 auto;">
        <div class="page-stickers" aria-hidden="true">
          <span class="page-sticker page-sticker--1">💬</span>
          <span class="page-sticker page-sticker--2">📮</span>
        </div>
        <p class="eyebrow">Contact us</p>
        <h1 style="font-size: 30px;">Questions, ideas, or something not working?</h1>
        <p>Send us a message and we'll get back to you.</p>
      </div>

      <div class="form-card" style="margin-top: 24px;">
        <form method="POST" action="/api/contact-messages">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" placeholder="Your name" required />

          <label for="email">Your email</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required />

          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="What's on your mind?" required></textarea>

          <button type="submit" class="btn btn-primary">Send message</button>
        </form>
      </div>
    </section>

    <%- include('layout-partials/footer') %>
  </div>
</body>
</html>
