<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: template.name }) %>
</head>
<body>
  <div class="overlay play-intro-overlay hidden" id="play-intro-overlay">
    <div class="modal-box">
      <p class="eyebrow">You've got a game</p>
      <h2><%= playData.senderName %> sent this to you<% if (playData.recipientName) { %>, <%= playData.recipientName %><% } %>.</h2>
      <% if (playData.note) { %>
        <p class="play-intro-overlay__note">&ldquo;<%= playData.note %>&rdquo;</p>
      <% } %>
      <button type="button" class="btn btn-primary" id="play-intro-start">Let's play</button>
    </div>
  </div>

  <div class="play-shell">
    <% if (playData.templateSlug === 'cake-catch') { %>
      <div class="play-instructions">Catch the cake and drag it into the mouse's mouth.</div>

      <div id="play-mouse">
        <div class="mouse-emoji">🐭</div>
        <div id="play-mouth"></div>
      </div>

      <div class="critter cake">🍰</div>
    <% } else if (playData.templateSlug === 'duck-catch') { %>
      <div class="play-instructions">Catch the duck before it gets away.</div>
      <div class="critter duck click-catch">🦆</div>
    <% } %>
    <!-- flappy-bird and cooking build their own markup via JS;
         an unrecognized slug gets a fallback message from play-client.js. -->
  </div>

  <script>
    window.__PLAY__ = <%- JSON.stringify(playData).replace(/</g, '\\u003c') %>;
  </script>
  <script src="/js/games/shared.js"></script>
  <script src="/js/games/cake-catch.js"></script>
  <script src="/js/games/duck-catch.js"></script>
  <script src="/js/games/flappy-bird.js"></script>
  <script src="/js/games/cooking.js"></script>
  <script src="/js/play-client.js"></script>
</body>
</html>
