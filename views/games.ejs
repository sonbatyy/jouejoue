<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Games' }) %>
</head>
<body>
  <%- include('layout-partials/page-bg') %>

  <div class="container">
    <%- include('layout-partials/nav') %>

    <section class="section" style="text-align: center;">
      <p class="eyebrow">The bank</p>
      <h1>Pick a game to send.</h1>
      <p style="max-width: 480px; margin: 10px auto 0;">Every game plays in under a minute. Not sure which one? <a href="/demo" style="color: var(--color-accent); font-weight: 700; text-decoration: none;">Try a demo</a> before you decide.</p>
    </section>

    <section class="section-tight">
      <div class="catalog-grid" data-reveal-stagger>
        <% const cardTones = ['', 'game-card--brown', 'game-card--black']; %>
        <% catalogGames.forEach(function(game, i) { %>
          <div class="game-card lift <%= cardTones[i % cardTones.length] %>">
            <span class="game-card__icon"><%= game.icon %></span>
            <h3><%= game.name %></h3>
            <p class="game-card__description"><%= game.description %></p>
            <div class="game-card__footer">
              <div class="game-card__price"><%= game.priceDisplay %></div>
              <a href="/payment/<%= game.id %>" class="btn btn-primary">Buy and create</a>
            </div>
          </div>
        <% }); %>
        <div class="game-card lift <%= cardTones[catalogGames.length % cardTones.length] %>">
          <span class="game-card__icon">✨</span>
          <h3>Something else in mind?</h3>
          <p class="game-card__description">Tell us what you want the game to be and what it's for.</p>
          <div class="game-card__footer">
            <div class="game-card__price"><%= customTier.priceDisplay %></div>
            <a href="/custom-request/<%= customTier.id %>" class="btn btn-secondary">Request a custom game</a>
          </div>
        </div>
      </div>
    </section>

    <%- include('layout-partials/footer') %>
  </div>

  <script src="/js/games/shared.js"></script>
  <script src="/js/emoji-field.js"></script>
  <script src="/js/reveal.js"></script>
</body>
</html>
