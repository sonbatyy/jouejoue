<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('layout-partials/head', { title: 'Renew · ' + template.name }) %>
</head>
<body>
  <%- include('layout-partials/page-bg') %>

  <div class="container">
    <%- include('layout-partials/nav') %>

    <section class="section-tight">
      <div style="text-align: center; max-width: 560px; margin: 0 auto;">
        <p class="eyebrow">Renew (mock, nothing is charged)</p>
        <h1 style="font-size: 30px;">Keep <%= instance.recipient_name %>'s game live.</h1>
        <p style="margin-top: 8px;">Another month, starting today — same link, same question if it hasn't been answered yet.</p>
      </div>

      <div class="form-card" style="margin-top: 24px; max-width: 420px;">
        <div class="order-summary">
          <div class="order-summary__row">
            <span><%= template.name %> — 1 month renewal</span>
            <strong><%= priceDisplay %></strong>
          </div>
        </div>

        <form method="POST" action="/renew/<%= instance.token %>" autocomplete="off">
          <label for="cardName">Name on card</label>
          <input type="text" id="cardName" name="cardName" placeholder="Jane Doe" />

          <label for="cardNumber">Card number</label>
          <input type="text" id="cardNumber" name="cardNumber" placeholder="4242 4242 4242 4242" inputmode="numeric" maxlength="19" />

          <div class="form-row">
            <div>
              <label for="cardExpiry">Expiry</label>
              <input type="text" id="cardExpiry" name="cardExpiry" placeholder="MM / YY" inputmode="numeric" maxlength="5" />
            </div>
            <div>
              <label for="cardCvc">CVC</label>
              <input type="text" id="cardCvc" name="cardCvc" placeholder="123" inputmode="numeric" maxlength="4" />
            </div>
          </div>

          <button type="submit" class="btn btn-primary wash" id="payButton">Renew for <%= priceDisplay %></button>
          <p class="form-fineprint">This is a prototype. No card processor is connected, nothing you type here is saved, and no money moves.</p>
        </form>
      </div>
    </section>

    <%- include('layout-partials/footer') %>
  </div>

  <script src="/js/card-input.js"></script>
  <script src="/js/games/shared.js"></script>
  <script src="/js/emoji-field.js"></script>
</body>
</html>
