PORT=3000

# console  -> log each notification to the server console (default)
# file     -> append each notification as a JSON line to data/outbox.log
# resend   -> actually sends via Resend's API — needs RESEND_API_KEY below
#             and a domain verified on your Resend account
EMAIL_MODE=console

# Only needed when EMAIL_MODE=resend. Get RESEND_API_KEY from
# resend.com -> API Keys. EMAIL_FROM_ADDRESS must be on a domain you've
# verified there (Resend -> Domains), e.g. answers@yourdomain.com.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=answers@joue-joue.com
# Where the site's Contact form actually delivers to — a real mailbox
# (Zoho or whatever you're using), not the Resend sending address above.
CONTACT_EMAIL_TO=contact@joue-joue.com

# Temporary shared-password gate (server/middleware/accessGate.js), so this
# prototype isn't wide open before real payments exist. Set both to your own
# values — ACCESS_GATE_SECRET should be a long random string, e.g. generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_GATE_PASSWORD=change-me
ACCESS_GATE_SECRET=change-me-too-a-long-random-string
